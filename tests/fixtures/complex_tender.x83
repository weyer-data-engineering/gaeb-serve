      <BoQBody>
        <BoQCtgy ID="L01" RNoPart="01">
          <LblTx><span>Trockenbau</span></LblTx>
          <BoQBody>
            <BoQCtgy ID="C0101" RNoPart="01">
              <LblTx><span>Wände</span></LblTx>
              <BoQBody>
                <Itemlist>
                  <Remark ID="R0101">
                    <Description>
                      <CompleteText>
                        <DetailTxt><Text><p><span>Alle Trockenbauwände nach DIN 18340 und den Verarbeitungsrichtlinien des Herstellers. Fugen und Anschlüsse in Qualitätsstufe Q2, sofern nicht anders angegeben.</span></p><p><span>Brandschutzanforderungen gemäß Brandschutzkonzept vom 15.09.2026, Index B.</span></p></Text></DetailTxt>
                      </CompleteText>
                    </Description>
                  </Remark>
                  <Item ID="I01.01.0010" RNoPart="0010">
                    <Qty>612.75</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><p><span>Metallständerwand, Gesamtdicke 100 mm, Ständer CW 50, beidseitig einlagig beplankt mit Gipsplatten GKF 12,5 mm, Hohlraum mit Mineralwolle 40 mm gedämmt.</span></p><p><span>Feuerwiderstand EI 30 nach DIN EN 13501-2, Schalldämmmaß Rw ≥ 44 dB.</span></p><p><span>Wandhöhe bis 3,25 m.</span></p></Text>
                          <TextComplement Kind="Bidder" MarkLbl="1" Empty="Yes"><ComplCaption>Plattenhersteller/Fabrikat: </ComplCaption><ComplBody><span>'....'</span></ComplBody></TextComplement>
                          <TextComplement Kind="Bidder" MarkLbl="2" Empty="Yes"><ComplCaption>Ständerprofil: </ComplCaption><ComplBody><span>'....'</span></ComplBody></TextComplement>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt><TextOutlTxt><span>Metallständerwand 100 mm, EI 30</span></TextOutlTxt></OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I01.01.0020" RNoPart="0020">
                    <Qty>184.3</Qty>
                    <QU>m2</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><p><span>Metallständerwand, Gesamtdicke 150 mm, Ständer CW 100, beidseitig zweilagig beplankt mit GKF 12,5 mm.</span></p><p><span>Feuerwiderstand EI 90, Schalldämmmaß Rw ≥ 53 dB, Hohlraumdämmung Mineralwolle Schmelzpunkt ≥ 1.000 °C.</span></p></Text>
                          <TextComplement Kind="Bidder" MarkLbl="1" Empty="Yes"><ComplCaption>Fabrikat/Systembezeichnung: </ComplCaption><ComplBody><span>'....'</span></ComplBody></TextComplement>
                          <TextComplement Kind="Bidder" MarkLbl="2" Empty="Yes"><ComplCaption>Prüfzeugnis-Nr.: </ComplCaption><ComplBody><span>'....'</span></ComplBody></TextComplement>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt><TextOutlTxt><span>Metallständerwand 150 mm, EI 90, doppelt beplankt</span></TextOutlTxt></OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I01.01.0030" RNoPart="0030">
                    <Qty>96</Qty>
                    <QU>m</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><p><span>Zulage zu Pos. 01.01.0010 und 01.01.0020 für gleitenden Deckenanschluss, Deckendurchbiegung bis 20 mm.</span></p></Text>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt><TextOutlTxt><span>Zulage Anschluss an Bestandsdecke gleitend</span></TextOutlTxt></OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I01.01.0040" RNoPart="0040">
                    <Qty>14</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><p><span>Türöffnung in Ständerwand herstellen, Laibungen mit UA-Profilen 2 mm verstärkt, Rohbaumaß 1.010 x 2.135 mm, einschließlich Sturz.</span></p></Text>
                          <TextComplement Kind="Owner" MarkLbl="1"><ComplCaption>Wanddicke: </ComplCaption><ComplBody><span>100 mm</span></ComplBody></TextComplement>
                        </DetailTxt>
                        <OutlineText>
                          <OutlTxt><TextOutlTxt><span>Türöffnung herstellen, UA-Profil</span></TextOutlTxt></OutlTxt>
                        </OutlineText>
                      </CompleteText>
                    </Description>
                  </Item>
                  <Item ID="I01.01.0050" RNoPart="0050">
                    <Qty>6</Qty>
                    <QU>St</QU>
                    <Description>
                      <CompleteText>
                        <DetailTxt>
                          <Text><p><span>Revisionsklappe in Trockenbauwand einbauen, Größe 300 x 300 mm, feuerwiderstandsfähig EI 30, weiß beschichtet.</span></p></Text>
                          <TextComplement Kind="Bidder" MarkLbl="1" Empty="Yes"><ComplCaption>Fabrikat: </ComplCaption><ComplBody><span>'....'</span></ComplBody></TextComplement>
                        </DetailTxt>
